# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - LICITACIÓN YA (SERCOP MONITOR)
# ==============================================================================
# Copie este archivo a '.env' y complete con sus credenciales reales.
# NUNCA versionar el archivo '.env' real en repositorios públicos o compartidos.

# Backend de Persistencia: 'turso' (cloud) | 'sqlite' (local) | 'supabase'
STORAGE_BACKEND=sqlite

# Turso Cloud SQLite (Requerido solo si STORAGE_BACKEND=turso)
TURSO_DATABASE_URL=libsql://tu-base-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-jwt-de-turso

# Base de datos SQLite local (Requerido solo si STORAGE_BACKEND=sqlite)
DATABASE_PATH=data/sercop.db

# Configuración de Alertas Telegram (Opcional)
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Configuración Email Transaccional (Resend - Opcional)
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_TO_EMAIL=alertas@tu-empresa.com
RESEND_FROM_EMAIL=LicitaciónYa Alertas <notificaciones@tu-dominio.com>

# Configuración WhatsApp (Evolution API - Se recomienda forzar HTTPS)
EVOLUTION_API_URL=https://tu-instancia-evolution.dominio.com
EVOLUTION_API_KEY=tu-api-key-segura
EVOLUTION_INSTANCE_NAME=licitacionya-bot
EVOLUTION_TARGET_NUMBER=593900000000

# Configuración API Oficial SERCOP OCDS
SERCOP_API_BASE_URL=https://datosabiertos.compraspublicas.gob.ec/PLATAFORMA/api
REQUEST_DELAY_SECONDS=3.2
REQUEST_TIMEOUT_SECONDS=20.0
MAX_REQUESTS_PER_RUN=150

# Nivel de registro de logs (En producción se recomienda WARNING o INFO)
LOG_LEVEL=INFO
