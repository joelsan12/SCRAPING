# Backend de Persistencia: 'turso' (cloud) o 'sqlite' (local) o 'supabase'
STORAGE_BACKEND=turso

# Turso Cloud SQLite (Recomendado: 9 GB gratis, sin pausas)
TURSO_DATABASE_URL=libsql://sercop-db-joelsan12.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# SQLite Database (solo si STORAGE_BACKEND=sqlite)
DATABASE_PATH=data/sercop.db

# Configuración de Alertas Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Configuración Email Transaccional (Resend - 100 emails/día gratis)
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_TO_EMAIL=cliente@empresa.com
RESEND_FROM_EMAIL=SERCOP Alertas <onboarding@resend.dev>

# Configuración WhatsApp (Evolution API en Oracle Cloud / VPS)
EVOLUTION_API_URL=http://tu-oracle-ip:8080
EVOLUTION_API_KEY=tu-global-api-key
EVOLUTION_INSTANCE_NAME=sercop-bot
EVOLUTION_TARGET_NUMBER=593979116551

# Configuración SERCOP API
SERCOP_API_BASE_URL=https://datosabiertos.compraspublicas.gob.ec/PLATAFORMA/api
REQUEST_DELAY_SECONDS=3.2
REQUEST_TIMEOUT_SECONDS=20.0

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
